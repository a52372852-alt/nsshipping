{
  "name": "ns-shipping-converter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:prepare": "python3 scripts/extract-expected.py",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.mjs *.json README.md docs/*.md samples/README.md",
    "build:crypto": "mkdir -p public/vendor && browserify scripts/crypto-worker.cjs -o public/vendor/crypto-worker.js",
    "prebuild": "npm run build:crypto",
    "predev": "npm run build:crypto"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.7",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "browserify": "^17.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
